{
  "name": "elr-page",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "scorm": "astro build && node scripts/empaquetar-scorm.mjs",
    "cmi5": "astro build && node scripts/empaquetar-cmi5.mjs",
    "xapi": "astro build && node scripts/empaquetar-xapi.mjs",
    "rise": "node scripts/adaptar-rise.mjs",
    "statements": "node --env-file-if-exists=.env scripts/listar-statements.mjs",
    "paquetes": "astro build && node scripts/empaquetar-scorm.mjs && node scripts/empaquetar-cmi5.mjs && node scripts/empaquetar-xapi.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}

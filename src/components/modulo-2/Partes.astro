---
/**
 * Registro de las partes del módulo 2.
 *
 * Recibe los ids que hay que pintar y los pinta en el orden de src/data/modulo-2.ts.
 * La web le pasa todos; cada página del paquete SCORM le pasa uno solo.
 */
import { partes } from '../../data/modulo-2'

import Resultados from './resultados.astro'
import DondeEstoy from './donde-estoy.astro'
import TodoCuelga from './todo-cuelga.astro'
import Mirar from './mirar.astro'
import Moverse from './moverse.astro'
import Pruebalo from './pruebalo.astro'
import Resumen from './resumen.astro'
import Glosario from './glosario.astro'
import Actividades from './actividades.astro'

const REGISTRO: Record<string, any> = {
	resultados: Resultados,
	'donde-estoy': DondeEstoy,
	'todo-cuelga': TodoCuelga,
	mirar: Mirar,
	moverse: Moverse,
	pruebalo: Pruebalo,
	resumen: Resumen,
	glosario: Glosario,
	actividades: Actividades,
}

interface Props {
	/** Ids a pintar. Si no se indica, se pintan todas. */
	ids?: string[]
}

const { ids } = Astro.props
const aPintar = (ids ?? partes.map((p) => p.id)).filter((id) => id in REGISTRO)

// Si un id del índice no tiene componente, es un fallo de datos: mejor saberlo.
const huerfanos = partes.filter((p) => !(p.id in REGISTRO)).map((p) => p.id)
if (huerfanos.length) {
	throw new Error(`Partes sin componente en Partes.astro: ${huerfanos.join(', ')}`)
}
---

{
	aPintar.map((id) => {
		const Seccion = REGISTRO[id]
		return <Seccion />
	})
}

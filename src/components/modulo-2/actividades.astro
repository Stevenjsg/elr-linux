---
import Quiz from './Quiz.astro'
import type { Pregunta } from './Quiz.astro'

const quizUno: Pregunta[] = [
	{
		enunciado: 'Estás en /home/alex/Fotos y escribes pwd. ¿Qué te contesta?',
		opciones: ['<code>Fotos</code>', '<code>/home/alex/Fotos</code>', '<code>~</code>', 'Nada, pwd no imprime'],
		correcta: 1,
		porque: '<code>pwd</code> siempre da la ruta absoluta completa, desde la raíz. El nombre corto es lo que enseña el prompt.',
	},
	{
		enunciado: '¿Cuál de estas órdenes te enseña los archivos ocultos?',
		opciones: ['<code>ls</code>', '<code>ls -l</code>', '<code>ls -a</code>', '<code>pwd</code>'],
		correcta: 2,
		porque: 'La <code>-a</code> viene de <em lang="en">all</em>. Sin ella, todo lo que empieza por punto se queda sin mostrar.',
	},
	{
		enunciado: 'En la salida de ls -l, una línea empieza por la letra d. ¿Qué significa?',
		opciones: [
			'Que el archivo está dañado',
			'Que es un directorio',
			'Que se puede descargar',
			'Que está oculto',
		],
		correcta: 1,
		porque: 'La primera letra dice el tipo: <code>d</code> de directorio, y un guion <code>-</code> para un archivo normal. Es la forma fiable de distinguirlos.',
	},
]

const quizDos: Pregunta[] = [
	{
		enunciado: 'Estás en /home/alex/Documentos y escribes cd .. ¿Dónde acabas?',
		opciones: ['<code>/home/alex</code>', '<code>/home</code>', '<code>/</code>', 'En la misma carpeta'],
		correcta: 0,
		porque: '<code>..</code> sube exactamente un nivel, a la carpeta que contiene a esta. Para subir dos, <code>cd ../..</code>.',
	},
	{
		enunciado: '¿Cuál de estas es una ruta absoluta?',
		opciones: [
			'<code>Fotos/vacaciones</code>',
			'<code>../proyecto</code>',
			'<code>/home/alex/Fotos</code>',
			'<code>./notas.txt</code>',
		],
		correcta: 2,
		porque: 'Una ruta absoluta empieza por <code>/</code> y vale desde cualquier sitio. Las otras tres cuentan desde donde estés en ese momento.',
	},
	{
		enunciado: 'Escribes cd Documentos y la terminal no contesta absolutamente nada. ¿Qué ha pasado?',
		opciones: [
			'Ha fallado sin avisar',
			'Ha funcionado',
			'La carpeta está vacía',
			'Hay que pulsar Enter otra vez',
		],
		correcta: 1,
		porque: 'En Linux el silencio es buena señal: si el comando sale bien, se calla. Compruébalo mirando el prompt o preguntando con <code>pwd</code>.',
	},
]
---

<section id="actividades" class="seccion">
	<h2 class="titulo-seccion">Actividades</h2>

	<p class="parrafo">
		Dos cuestionarios cortos para comprobar que lo de arriba se ha quedado. Se corrigen solos y
		puedes repetirlos las veces que quieras: no cuentan para nada, están para que veas dónde flojeas.
	</p>

	<Quiz id="quiz-donde" titulo="1. ¿Dónde estoy y qué hay aquí?" preguntas={quizUno} />
	<Quiz id="quiz-moverse" titulo="2. Moverse sin perderse" preguntas={quizDos} />

	<p class="quiz-total" data-total-actividades role="status" hidden></p>
</section>

<script>
	/**
	 * Junta el resultado de los dos cuestionarios. Dentro de un paquete (SCORM o
	 * cmi5) informa de la puntuación a la plataforma; en la web se queda en un
	 * resumen en pantalla.
	 */
	const resultados = new Map<string, { aciertos: number; total: number }>()
	const resumen = document.querySelector<HTMLElement>('[data-total-actividades]')
	const CUESTIONARIOS = 2

	document.addEventListener('quiz:corregido', (evento) => {
		const { id, aciertos, total } = (evento as CustomEvent).detail
		resultados.set(id, { aciertos, total })
		if (resultados.size < CUESTIONARIOS || !resumen) return

		let aciertosTotales = 0
		let preguntasTotales = 0
		for (const r of resultados.values()) {
			aciertosTotales += r.aciertos
			preguntasTotales += r.total
		}

		const porcentaje = Math.round((aciertosTotales / preguntasTotales) * 100)
		const aprobado = porcentaje >= 70

		const texto =
			`Los dos cuestionarios: ${aciertosTotales} de ${preguntasTotales} (${porcentaje} %). ` +
			(aprobado ? 'Lo tienes.' : 'Repasa las explicaciones y repite.')
		resumen.hidden = false
		resumen.textContent = texto

		// Solo existe en las páginas de los paquetes (SCORM o cmi5); en la web no hay nada.
		const plataforma = (window as any).PLATAFORMA
		plataforma?.puntuar?.(porcentaje, aprobado).then((enviado: boolean) => {
			if (enviado) resumen.textContent = `${texto} Puntuación enviada a la plataforma.`
		})
	})
</script>

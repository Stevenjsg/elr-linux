---
import '../styles/global.css'

interface Props {
	title?: string
	description?: string
}

const {
	title = 'elr — aprende Linux sin romper nada',
	description = 'Curso de Linux desde cero: instalas el sistema (o una máquina virtual) y acabas encadenando comandos sin mirar la chuleta.',
} = Astro.props
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;600&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap"
		/>
		<title>{title}</title>
	</head>
	<body>
		<a class="saltar" href="#contenido">Saltar al contenido</a>
		<slot />
	</body>
</html>

---
/**
 * Envoltorio de una parte suelta dentro de un paquete SCORM.
 *
 * Deliberadamente NO lleva la navegación del sitio: dentro de un LMS cada parte
 * es un SCO independiente y es el reproductor del LMS quien navega entre ellas.
 * El envoltorio de la API va en línea para que el paquete no dependa de rutas.
 */
import { leccion, partes } from '../data/modulo-2'
import '../styles/global.css'
import '../styles/leccion.css'

interface Props {
	parteId: string
}

const { parteId } = Astro.props
const parte = partes.find((p) => p.id === parteId)!
const posicion = partes.findIndex((p) => p.id === parteId) + 1
// Una parte con cuestionario informa ella misma de su nota: el botón genérico sobra.
const botonGenerico = !parte.completaSola
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={`${parte.titulo} — ${leccion.titulo}. ${leccion.descripcion}`} />
		<title>{parte.titulo} — {leccion.titulo}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;600&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap"
		/>

		<script is:inline>
			/* Envoltorio mínimo de SCORM 1.2. Sin LMS, la página se lee igual. */
			window.SCORM = (function () {
				var API = null
				var vivo = false

				function buscar(v) {
					var saltos = 0
					while (v && !v.API && v.parent && v.parent !== v && saltos < 500) {
						saltos++
						v = v.parent
					}
					return v ? v.API : null
				}

				function localizar() {
					try {
						return buscar(window) || (window.opener ? buscar(window.opener) : null)
					} catch (e) {
						return null
					}
				}

				return {
					iniciar: function () {
						API = localizar()
						if (!API) return false
						vivo = API.LMSInitialize('') === 'true'
						if (vivo) {
							var estado = API.LMSGetValue('cmi.core.lesson_status')
							if (!estado || estado === 'not attempted') {
								API.LMSSetValue('cmi.core.lesson_status', 'incomplete')
								API.LMSCommit('')
							}
						}
						return vivo
					},
					yaCompletada: function () {
						return vivo && API.LMSGetValue('cmi.core.lesson_status') === 'completed'
					},
					completar: function () {
						if (!vivo) return false
						API.LMSSetValue('cmi.core.lesson_status', 'completed')
						API.LMSCommit('')
						return true
					},
					/* Para las partes con cuestionario: nota sobre 100 y aprobado/suspenso. */
					puntuar: function (bruta, aprobado) {
						if (!vivo) return false
						API.LMSSetValue('cmi.core.score.min', '0')
						API.LMSSetValue('cmi.core.score.max', '100')
						API.LMSSetValue('cmi.core.score.raw', String(bruta))
						API.LMSSetValue('cmi.core.lesson_status', aprobado ? 'passed' : 'failed')
						API.LMSCommit('')
						return true
					},
					cerrar: function () {
						if (!vivo) return
						API.LMSFinish('')
						vivo = false
					},
				}
			})()
		</script>
	</head>

	<body>
		<a class="saltar" href="#contenido">Saltar al contenido</a>

		<div class="mx-auto max-w-[1180px] px-4 pb-16 sm:px-8">
			<header class="flex flex-wrap items-baseline gap-x-3 gap-y-1 pt-6 pb-1">
				<span class="font-mono text-xl font-semibold tracking-tight text-uva">elr</span>
				<span class="font-mono text-[0.72rem] text-tinta/70">linux desde cero</span>
			</header>

			<main id="contenido">
				{/* El h1 de la página es la lección: la parte es una sección (h2) dentro de ella,
				    así la jerarquía no da saltos aunque cada parte sea una página suelta. */}
				<h1 class="mt-5 text-[1.3rem] font-extrabold tracking-[-0.02em]">{leccion.titulo}</h1>

				<p class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-1 font-mono text-[0.76rem] font-semibold text-uva">
					<span>{leccion.tramo}</span>
					<span class="text-tinta/70">Parte {posicion} de {partes.length}</span>
					{parte.minutos > 0 && <span class="text-tinta/70">{parte.minutos} min aprox.</span>}
				</p>

				<slot />

				{
					botonGenerico && (
						<div class="cierre-scorm">
							<p>
								Cuando hayas leído esta parte, márcala para que el progreso quede registrado en la
								plataforma.
							</p>
							<button type="button" class="boton-scorm" id="completar">He terminado esta parte</button>
							<p class="estado-scorm" id="estado" role="status">Progreso sin registrar todavía.</p>
						</div>
					)
				}
			</main>

			<footer class="mt-12 border-t-[3px] border-tinta pt-6 font-mono text-[0.74rem] text-tinta/70">
				{leccion.pie}
			</footer>
		</div>

		<script is:inline>
			;(function () {
				var conLMS = window.SCORM.iniciar()
				var boton = document.getElementById('completar')
				var estado = document.getElementById('estado')

				window.addEventListener('pagehide', function () {
					window.SCORM.cerrar()
				})

				// Las partes con cuestionario no tienen botón: se puntúan solas.
				if (!boton || !estado) return

				function marcarHecha(enviado) {
					boton.disabled = true
					boton.textContent = 'Parte completada'
					estado.textContent = enviado
						? 'Parte completada y enviada a la plataforma.'
						: 'Parte completada. No hay plataforma a la escucha, así que no se ha enviado nada.'
				}

				if (conLMS && window.SCORM.yaCompletada()) {
					marcarHecha(true)
				} else {
					estado.textContent = conLMS
						? 'Conectado a la plataforma. Tu progreso se guardará al marcar esta parte.'
						: 'Abierto fuera de una plataforma: puedes leer la parte, pero el progreso no se guarda.'
				}

				boton.addEventListener('click', function () {
					marcarHecha(window.SCORM.completar())
				})
			})()
		</script>
	</body>
</html>

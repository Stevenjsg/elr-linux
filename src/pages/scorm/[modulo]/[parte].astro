---
/**
 * Una página por parte de cada módulo, para empaquetar como SCORM 1.2.
 *
 * Astro las genera en dist/scorm/<modulo>/<parte>/. El script
 * scripts/empaquetar-scorm.mjs las reorganiza, reescribe las rutas de los
 * recursos a relativas y las comprime junto con el imsmanifest.xml.
 */
import ParteSuelta from '../../../layouts/ParteSuelta.astro'
import PartesModulo from '../../../components/PartesModulo.astro'
import { modulos } from '../../../data/modulos'

export function getStaticPaths() {
	return modulos.flatMap((modulo) =>
		modulo.partes.map((parte) => ({ params: { modulo: modulo.slug, parte: parte.id }, props: { modulo } })),
	)
}

const { modulo } = Astro.props
const { parte } = Astro.params
---

<ParteSuelta modulo={modulo} parteId={parte!} plataforma="scorm">
	<PartesModulo modulo={modulo.slug} ids={[parte!]} />
</ParteSuelta>
